{
  "name": "daily-brief",
  "version": "1.0.0",
  "description": "Daily Brief — offline-ready news podcast queue (PWA)",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "express": "^4.22.3",
    "fast-xml-parser": "^4.5.7",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5"
  },
  "private": true,
  "type": "module"
}
